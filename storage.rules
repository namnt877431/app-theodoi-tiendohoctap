rules_version = '2';

// Ảnh bài làm nằm ở baiLam/{hocSinhId}/{tên tệp}.
//
// Cùng một nguyên tắc với Firestore: chỉ chính học sinh và phụ huynh đã nối
// mới xem được ảnh vở của em ấy. Storage đọc được Firestore nên phép kiểm tra
// "có phải phụ huynh của em này không" dùng chung một nguồn sự thật.
service firebase.storage {
  match /b/{bucket}/o {

    function daVao() {
      return request.auth != null;
    }

    function conCuaToi() {
      return firestore.get(/databases/(default)/documents/nguoiDung/$(request.auth.uid))
        .data.get('conIds', []);
    }

    function laQuanTri() {
      return daVao() && firestore.get(
        /databases/(default)/documents/nguoiDung/$(request.auth.uid)
      ).data.vaiTro == 'quanTri';
    }

    match /baiLam/{hocSinhId}/{tep} {
      allow read: if daVao()
        && (request.auth.uid == hocSinhId
            || hocSinhId in conCuaToi()
            || laQuanTri());

      // Chỉ học sinh tự đưa ảnh bài của mình lên, tối đa 8 MB, và phải là ảnh.
      allow write: if daVao()
        && request.auth.uid == hocSinhId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if daVao()
        && (request.auth.uid == hocSinhId || laQuanTri());
    }

    match /{tatCa=**} {
      allow read, write: if false;
    }
  }
}
