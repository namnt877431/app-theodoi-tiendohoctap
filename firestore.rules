rules_version = '2';

// Luật bảo mật cho Sổ liên lạc.
//
// Nguyên tắc: dữ liệu học tập là dữ liệu của trẻ con, nên mặc định là cấm.
// Một người chỉ đọc được dữ liệu của học sinh X khi họ chính là X, là phụ
// huynh đã được nối với X, hoặc là quản trị.
//
// Việc nối phụ huynh với con không tin lời client. Phụ huynh chỉ thêm được
// một id vào `conIds` khi kèm theo mã mời còn hiệu lực trỏ đúng vào id đó —
// nghĩa là họ phải thật sự cầm mã do con sinh ra.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- trợ giúp

    function daVao() {
      return request.auth != null;
    }

    function toi() {
      return request.auth.uid;
    }

    function hoSo(uid) {
      return get(/databases/$(database)/documents/nguoiDung/$(uid)).data;
    }

    function coHoSo(uid) {
      return exists(/databases/$(database)/documents/nguoiDung/$(uid));
    }

    function laQuanTri() {
      return daVao() && coHoSo(toi()) && hoSo(toi()).vaiTro == 'quanTri';
    }

    function conCuaToi() {
      return daVao() && coHoSo(toi()) ? hoSo(toi()).get('conIds', []) : [];
    }

    function laPhuHuynhCua(hsId) {
      return hsId in conCuaToi();
    }

    // Ai được nhìn vào dữ liệu học tập của học sinh này.
    function xemDuoc(hsId) {
      return daVao() && (toi() == hsId || laPhuHuynhCua(hsId) || laQuanTri());
    }

    function doi(truong) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(truong);
    }

    // ---------------------------------------------------------------- mã mời

    function ma(m) {
      return get(/databases/$(database)/documents/maMoi/$(m)).data;
    }

    function maConSong(m) {
      return exists(/databases/$(database)/documents/maMoi/$(m))
        && ma(m).daDung == false
        && ma(m).hetHan > request.time;
    }

    // Phụ huynh chỉ được thêm đúng một id, và id đó phải là học sinh mà mã mời
    // kèm theo trỏ tới. Không có mã thì không nối được với ai.
    function themConHopLe() {
      let m = request.resource.data.get('maMoiDaDung', '');
      let cu = resource.data.get('conIds', []);
      let moi = request.resource.data.get('conIds', []);
      return m != ''
        && maConSong(m)
        && moi.hasOnly(cu.concat([ma(m).hocSinhId]))
        && moi.hasAll(cu)
        && moi.size() == cu.size() + 1;
    }

    // Bỏ theo dõi thì tùy phụ huynh, không cần mã.
    function botConHopLe() {
      let cu = resource.data.get('conIds', []);
      let moi = request.resource.data.get('conIds', []);
      return cu.hasAll(moi) && moi.size() < cu.size();
    }

    match /maMoi/{m} {
      // Ai cầm được mã thì đọc và tiêu được mã đó — bản thân con số sáu chữ số
      // chính là bí mật. Không cho liệt kê cả bộ sưu tập.
      allow get: if daVao();
      allow list: if laQuanTri();

      // Chỉ học sinh tự sinh mã cho chính mình.
      allow create: if daVao()
        && request.resource.data.hocSinhId == toi()
        && request.resource.data.daDung == false;

      // Đánh dấu đã dùng, hoặc tự hủy mã cũ của mình.
      allow update: if daVao()
        && doi(['daDung'])
        && request.resource.data.daDung == true
        && (resource.data.hocSinhId == toi() || maConSong(m));

      allow delete: if laQuanTri();
    }

    // ------------------------------------------------------------ người dùng

    match /nguoiDung/{uid} {
      // Đọc được hồ sơ của chính mình, của con mình, và quản trị đọc tất cả.
      allow get: if daVao() && (toi() == uid || uid in conCuaToi() || laQuanTri());
      allow list: if laQuanTri();

      // Đăng ký: tự tạo hồ sơ cho chính mình, không tự phong quản trị,
      // không tự mở sẵn danh sách con. Tài khoản quản trị tạo tay trong Console.
      allow create: if daVao()
        && toi() == uid
        && request.resource.data.vaiTro in ['phuHuynh', 'hocSinh']
        && request.resource.data.get('hoatDong', true) == true
        && request.resource.data.get('conIds', []).size() == 0;

      allow update: if laQuanTri()
        // Sửa thông tin cá nhân của chính mình. Vai trò, khóa/mở và danh sách
        // con nằm ngoài tầm với.
        || (daVao() && toi() == uid
            && doi(['hoTen', 'email', 'soDienThoai', 'lop', 'truong']))
        // Nối thêm con bằng mã mời, hoặc bỏ theo dõi một đứa.
        || (daVao() && toi() == uid
            && doi(['conIds', 'maMoiDaDung'])
            && (themConHopLe() || botConHopLe()));

      allow delete: if laQuanTri();
    }

    // ------------------------------------------------------- danh mục dùng chung

    match /monHoc/{id} {
      allow read: if daVao();
      allow write: if laQuanTri();
    }

    match /giaoVien/{id} {
      allow read: if daVao();
      allow write: if laQuanTri();
    }

    // ------------------------------------------------------ dữ liệu học tập

    match /hocSinh/{hsId} {
      allow read: if xemDuoc(hsId);
      allow write: if false;

      // Thời khóa biểu: cả học sinh lẫn phụ huynh đều nhập được, vì nhiều nhà
      // bố mẹ là người ngồi khai hộ đầu năm.
      match /tietHoc/{id} {
        allow read: if xemDuoc(hsId);
        allow write: if xemDuoc(hsId);
      }

      match /baoCao/{id} {
        allow read: if xemDuoc(hsId);

        // Báo cáo là lời của học sinh. Chỉ chính em ấy viết, sửa và xóa.
        allow create: if daVao() && toi() == hsId
          && request.resource.data.hocSinhId == hsId;
        allow delete: if daVao() && (toi() == hsId || laQuanTri());

        allow update: if (daVao() && toi() == hsId)
          || laQuanTri()
          // Phụ huynh chỉ chạm được vào phần của mình: lời nhận xét và dấu đã xem.
          || (laPhuHuynhCua(hsId) && doi(['nhanXetPhuHuynh', 'phuHuynhDaXem']));
      }

      match /nhacNho/{id} {
        allow read: if xemDuoc(hsId);

        // Chỉ phụ huynh đã nối mới nhắc được, và phải ký tên chính mình.
        allow create: if laPhuHuynhCua(hsId)
          && request.resource.data.tuId == toi()
          && request.resource.data.denId == hsId
          && request.resource.data.get('daDoc', false) == false;

        // Học sinh đánh dấu đã đọc; phụ huynh không tự đánh dấu hộ.
        allow update: if (daVao() && toi() == hsId && doi(['daDoc']))
          || laQuanTri();

        allow delete: if (laPhuHuynhCua(hsId) && resource.data.tuId == toi())
          || laQuanTri();
      }
    }

    // Mọi thứ chưa được nêu tên ở trên đều bị chặn.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
